# Copy this file to .env.local for local development (.env.local is gitignored).
# Never commit real values. Only VITE_-prefixed variables are exposed to the browser.

# Set to "false" to disable the "Explore demo" entry point and demo mode in
# production. Defaults to enabled (any value other than the literal "false").
VITE_ENABLE_DEMO_MODE=true

# --- Supabase (backend + auth) ------------------------------------------------
# From your Supabase project: Settings -> API.
# The anon key is safe to expose in the frontend (protected by row-level
# security) — never put the service_role key here or anywhere client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Voice transcription (server-side only, NOT prefixed with VITE_) ---------
# These are read by the Supabase Edge Function that proxies speech-to-text —
# set them with `supabase secrets set OPENAI_API_KEY=...`, never in this file
# and never in any VITE_-prefixed variable, since VITE_ vars are bundled into
# the client-side JavaScript.
# OPENAI_API_KEY=
